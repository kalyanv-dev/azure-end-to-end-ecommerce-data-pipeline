{
	"name": "adlsCSV_sink_db",
	"properties": {
		"linkedServiceName": {
			"referenceName": "adf_to_ecommerceadls_ls",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"File_name": {
				"type": "string"
			},
			"Schema_Name": {
				"type": "string"
			},
			"Table_name": {
				"type": "string"
			},
			"Date": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().File_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(\n    dataset().Schema_Name,\n    '/',\n    dataset().Table_name,\n    '/',\n    dataset().Date\n)",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}